APP_URL=http://127.0.0.1:3000
# DATABASE_URL="postgresql://user:password@localhost:5432/db"
# Generate a persistent secret with openssl rand -hex 32.
# APP_SECRET=
# DISABLE_DB_WARN=true

# AI vision provider (ollama | openai | anthropic | gemini | custom)
# Manual entry works while the local reader is stopped.
VISION_PROVIDER=ollama

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2-vision

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-luna

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite

# Custom OpenAI-compatible provider
# CUSTOM_BASE_URL=http://localhost:8080/v1
# CUSTOM_MODEL=llama3.2-vision
# CUSTOM_API_KEY=

# SMTP (required in production; local links go to the server console when unset)
# Resend example. Use a verified sending domain and a sending API key.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=your_resend_sending_key
# SMTP_FROM="CardTuck <signin@send.example.com>"

# UI language
# LOCALE=en

# Auth — limit sign-in and registration to specific email addresses
# AUTH_ALLOWED_EMAILS=owner@example.com,friend@example.net

# Optionally require an allowed email domain as well
# AUTH_WHITELISTED_DOMAINS=example.com,other.com

# Production registration is opt-in. Enable it while provisioning allowed accounts.
# AUTH_ALLOW_REGISTRATION=true

# Optional CardDAV. Enter exact trusted origins, including scheme and any port.
# CARDDAV_ALLOWED_ORIGINS=https://contacts.example.com

# Additional trusted CORS origins (optional)
# AUTORIZED_DOMAINS=https://app.example.com

# Set after confirming delivery to the public support inbox.
# CARDTUCK_SUPPORT_EMAIL=support@cardtuck.app
